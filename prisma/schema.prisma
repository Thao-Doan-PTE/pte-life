generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExamPackage {
  academic
  core
}

enum Skill {
  speaking
  writing
  reading
  listening
}

enum Role {
  ADMIN
  OPS
  ACADEMIC_LEAD
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ClassStatus {
  UPCOMING
  ACTIVE
  FINISHED
  ARCHIVED
}

enum ClassTeacherRole {
  MAIN
  ASSISTANT
}

enum ClassEnrollmentStatus {
  ACTIVE
  PAUSED
  LEFT
}

enum MockTestMode {
  question
  section
  full
  tu
}

/// Ngân hàng câu hỏi: PTE = luyện đề theo cấu trúc thi thật (22 dạng theo
/// questionTypeId); TU = bộ câu hỏi "Tủ" riêng, hiện chỉ tập trung 2 dạng
/// khó đoán trước đề (WFD, RS) để học viên luyện trọng tâm.
enum QuestionBank {
  PTE
  TU
}

enum MockTestStatus {
  in_progress
  completed
}

model User {
  id               String      @id @default(cuid())
  name             String
  email            String      @unique
  passwordHash     String
  roles            Role[]      @default([STUDENT])
  status           UserStatus  @default(ACTIVE)
  examPackage      ExamPackage
  expiresAt        DateTime
  reservationsLeft Int         @default(2)
  hasSeenWelcome   Boolean     @default(false)
  avatarUrl        String?
  /// Bảo lưu đến ngày này (null = không bảo lưu). Chỉ để hiển thị trạng thái —
  /// lượt bảo lưu vẫn trừ reservationsLeft và cộng 30 ngày vào expiresAt như cũ.
  reservedUntil    DateTime?
  /// Điểm mục tiêu PTE (10–90) của học viên.
  targetScore      Int?
  /// Được dùng thử Luyện đề Tủ tới hết ngày này (null = không) — dành cho danh
  /// sách mời chạy thử, kể cả tài khoản chưa được xếp lớp. Chỉ mở bộ đề Tủ
  /// (WFD, RS); Luyện đề PTE và các phần khác vẫn cần lớp học như cũ.
  tuTrialUntil     DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  attempts             PracticeAttempt[]
  mockTestSessions     MockTestSession[]
  reservationLogs      ReservationLog[]      @relation("ReservationLogsForUser")
  favorites            Favorite[]
  savedWords           SavedWord[]
  createdClasses       Class[]               @relation("ClassCreatedBy")
  teachingClasses      ClassTeacher[]
  classEnrollments     ClassEnrollment[]
  auditLogs            AuditLog[]            @relation("AuditLogActor")
  auditLogsAboutMe     AuditLog[]            @relation("AuditLogTarget")
  teacherProfile       TeacherProfile?
  assignmentsCreated   Assignment[]          @relation("AssignmentCreatedBy")
  assignmentRecipients AssignmentRecipient[]
  gradesGiven          AttemptGrade[]        @relation("AttemptGradedBy")
  entryTestAttempts    EntryTestAttempt[]    @relation("EntryTestAttemptsForUser")
  consultationRequests ConsultationRequest[]
  entryTestGraded      EntryTestAttempt[]    @relation("EntryTestAttemptsGradedBy")
}

/// Lớp học — Bước LMS giai đoạn 1. examType dùng lại enum ExamPackage có sẵn
/// (không tạo enum trùng) vì cùng ý nghĩa PTE Academic/PTE Core.
model Class {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  examType    ExamPackage
  targetScore Int?
  startDate   DateTime?
  endDate     DateTime?
  schedule    String?
  meetingUrl  String?
  status      ClassStatus @default(UPCOMING)
  /// Tổng số buổi của khoá (null = chưa nhập) và số buổi đã học — vận hành nhập tay.
  sessionsTotal Int?
  sessionsDone  Int       @default(0)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy   User              @relation("ClassCreatedBy", fields: [createdById], references: [id])
  teachers    ClassTeacher[]
  enrollments ClassEnrollment[]
  assignments Assignment[]
}

model ClassTeacher {
  id        String           @id @default(cuid())
  classId   String
  teacherId String
  role      ClassTeacherRole @default(MAIN)
  createdAt DateTime         @default(now())

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
  @@index([teacherId])
}

model ClassEnrollment {
  id        String                @id @default(cuid())
  classId   String
  studentId String
  status    ClassEnrollmentStatus @default(ACTIVE)
  joinedAt  DateTime              @default(now())
  leftAt    DateTime?

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
}

/// Hồ sơ giáo viên (chuyên môn) — 1-1 với User có role TEACHER, tạo khi cần.
model TeacherProfile {
  userId    String   @id
  specialty String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Audit log tổng quát cho các thao tác LMS (Class/ClassTeacher/ClassEnrollment
/// trở đi) — tách riêng khỏi ReservationLog hiện có (ReservationLog chỉ dành
/// cho đổi gói/gia hạn/bảo lưu, giữ nguyên không đụng tới). Xem docs/LMS_DECISIONS.md.
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  action       String
  entityType   String
  entityId     String
  detail       String?
  /// Vai trò của người thao tác tại thời điểm thao tác (dòng cũ: rỗng = không rõ).
  actorRoles   Role[]   @default([])
  /// Học viên/người dùng bị tác động (nếu có).
  targetUserId String?
  /// Dữ liệu trước/sau khi thay đổi.
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actor      User  @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUser User? @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

/// Log các lần admin/CSKH gán gói, gia hạn, hoặc dùng lượt bảo lưu cho học viên (Bước 11).
model ReservationLog {
  id            String   @id @default(cuid())
  userId        String
  performedById String
  action        String // "extend" | "reservation" | "change_package"
  detail        String
  createdAt     DateTime @default(now())

  user User @relation("ReservationLogsForUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 1 lượt làm Mocktest (Question Test / Section Test / Full Test — Bước 9).
/// Không lưu điểm từng câu ở đây — điểm lấy lại từ PracticeAttempt mới nhất của
/// mỗi câu trong questionIds khi tính kết quả, tránh trùng lặp dữ liệu chấm điểm.
model MockTestSession {
  id             String         @id @default(cuid())
  userId         String
  mode           MockTestMode
  skill          Skill?
  questionTypeId String?
  questionIds    String[]
  currentIndex   Int            @default(0)
  status         MockTestStatus @default(in_progress)
  scorePct       Int?
  /// Điểm GSE (10-90) theo đúng chuẩn Pearson — chỉ tính cho mode "full" (xem
  /// lib/gse-scoring.ts). Không phải trung bình cộng scorePct mà là tỷ lệ điểm
  /// đạt/tối đa có trọng số theo overallWeightPct và weighting[skill] của từng
  /// dạng câu hỏi (Integrated Skills Routing — 1 câu có thể cộng điểm vào nhiều
  /// kỹ năng, ví dụ WFD cộng cả Listening lẫn Writing).
  overallScore   Int?
  listeningScore Int?
  readingScore   Int?
  speakingScore  Int?
  writingScore   Int?
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  /// Lượt Mock test làm theo bài tập được giao (null = tự luyện).
  assignmentId   String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([assignmentId])
}

/// Ngân hàng câu hỏi: mỗi row là 1 câu hỏi cụ thể thuộc 1 dạng (questionTypeId
/// khớp với id trong lib/question-types.ts). `content` linh hoạt theo từng dạng
/// (đoạn văn, audio mẫu, đáp án đúng, các lựa chọn...) vì 22 dạng có cấu trúc rất khác nhau.
model Question {
  id             String        @id @default(cuid())
  questionTypeId String
  skill          Skill
  code           String        @unique
  availableIn    ExamPackage[]
  bank           QuestionBank  @default(PTE)
  content        Json
  /// Nguồn đề, vd "Pearson", "PTE-Life biên soạn", "Tủ T10/2026".
  source         String?
  /// Ẩn/lưu trữ thay vì xoá hẳn (null = đang dùng).
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attempts        PracticeAttempt[]
  favorites       Favorite[]
  assignmentItems AssignmentItem[]

  @@index([questionTypeId])
  @@index([bank])
}

/// Kết quả 1 lượt làm bài, gắn với learner + question. Chấm rule-based (Bước 6)
/// ghi ngay khi nộp bài; các dạng cần AI (Writing/Speaking) sẽ ghi ở Bước 7-8.
model PracticeAttempt {
  id             String   @id @default(cuid())
  userId         String
  questionId     String
  questionTypeId String
  scorePct       Int
  pteScore       Int
  isCorrect      Boolean
  response       Json
  durationSec    Int      @default(0)
  /// Bài làm thuộc bài tập được giao (null = tự luyện).
  assignmentId   String?
  /// null = không cần giáo viên chấm (mọi bài tự luyện và bài cũ).
  reviewStatus   ReviewStatus?
  /// File ghi âm Speaking (để giáo viên nghe khi chấm).
  audioUrl       String?
  createdAt      DateTime @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  assignment Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  grade      AttemptGrade?

  @@index([userId])
  @@index([questionId])
  @@index([assignmentId])
  @@index([reviewStatus, createdAt])
}

/// Câu hỏi học viên đánh dấu "Ưa thích" để lọc lại nhanh trong danh sách câu hỏi.
model Favorite {
  id             String   @id @default(cuid())
  userId         String
  questionId     String
  questionTypeId String
  createdAt      DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, questionTypeId])
}

/// Từ vựng học viên lưu lại khi chạm vào từ trong đoạn văn để tra nghĩa nhanh —
/// hiện lại ở trang "Sổ từ vựng".
model SavedWord {
  id        String   @id @default(cuid())
  userId    String
  word      String
  phonetic  String?
  meaningVi String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId])
}

enum EntryTestPurpose {
  DU_HOC
  DINH_CU
  XIN_VIEC
  KHAC
}

/// Lead thu được từ form "Test đầu vào" ở trang chủ LMS — khách/học viên mới
/// chưa chắc đã có tài khoản (userId để trống ở bước thu lead). Việc thật sự
/// làm bài test và gắn kết quả sẽ làm ở Phase 2 (xem docs/LMS_DECISIONS.md).
model EntryTestLead {
  id           String           @id @default(cuid())
  name         String
  phone        String
  email        String?
  targetScore  String
  purpose      EntryTestPurpose
  examTimeline String
  consentAt    DateTime
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  createdAt    DateTime         @default(now())

  @@index([createdAt])
}

enum EntryTestAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

/// 1 lượt làm "Test đầu vào" thật của học viên đã có tài khoản (Phase 2, xem
/// docs/LMS_DECISIONS.md). Khác với EntryTestLead (chỉ thu thông tin liên hệ
/// của khách/học viên mới chưa chắc có tài khoản) — model này gắn với User
/// thật, lưu toàn bộ bài làm để giáo viên chấm Speaking/Listening (nội dung
/// hiện tại chưa có đáp án Listening, xem lib/entry-test-data.ts) và theo dõi
/// tiến trình chấm. Câu hỏi/đáp án của đề cố định được lưu tĩnh trong code
/// (lib/entry-test-data.ts), không tạo bảng Question riêng, vì đây là 1 đề
/// cố định (26 câu) chưa được học thuật duyệt, không phải ngân hàng câu hỏi
/// mở rộng như PracticeAttempt/Question.
model EntryTestAttempt {
  id            String                 @id @default(cuid())
  userId        String
  startedAt     DateTime               @default(now())
  submittedAt   DateTime?
  autoSubmitted Boolean                @default(false)
  scoreAuto     Int?
  scoreSpeaking Int?
  scoreTotal    Int?
  level         String?
  status        EntryTestAttemptStatus @default(IN_PROGRESS)
  gradedById    String?
  gradedAt      DateTime?

  user     User              @relation("EntryTestAttemptsForUser", fields: [userId], references: [id], onDelete: Cascade)
  gradedBy User?             @relation("EntryTestAttemptsGradedBy", fields: [gradedById], references: [id])
  answers  EntryTestAnswer[]

  @@index([userId])
}

/// 1 câu trả lời trong 1 lượt làm — questionId khớp id tĩnh trong
/// lib/entry-test-data.ts (vd. "S1", "W1".."W10", "R1".."R5", "L1".."L10").
model EntryTestAnswer {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  responseText  String?
  audioUrl      String?
  isCorrect     Boolean?
  pointsAwarded Int?
  feedback      String?
  createdAt     DateTime @default(now())

  attempt EntryTestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

enum ConsultationStatus {
  NEW
  CONTACTED
  DONE
}

/// Yêu cầu đặt lịch tư vấn lộ trình của học viên (sau khi làm Test đầu vào):
/// học viên chọn ngày + khung giờ muốn được tư vấn viên liên hệ.
model ConsultationRequest {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  email         String?
  preferredDate DateTime
  timeSlot      String
  note          String?
  /// "consult" = tư vấn lộ trình, "trial" = đăng ký học thử miễn phí
  topic         String             @default("consult")
  status        ConsultationStatus @default(NEW)
  createdAt     DateTime           @default(now())

  @@index([userId])
  @@index([status, createdAt])
}

// Bộ đếm chống lạm dụng (đăng nhập sai, đăng ký, chấm AI…): mỗi dòng = số lần
// của 1 `key` trong 1 khung thời gian cố định bắt đầu từ `windowStart`. Tăng
// bằng 1 câu lệnh INSERT … ON CONFLICT DO UPDATE (nguyên tử, không cần khoá hay
// transaction dài) nên gửi dồn request song song cũng không vượt được giới hạn.
// Lưu trong DB (không phải bộ nhớ) vì trên Vercel mỗi request có thể chạy ở
// một instance khác nhau.
model RateLimitCounter {
  key         String
  windowStart DateTime
  expiresAt   DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([expiresAt])
}

// ===== Admin LMS đợt 2: Giao bài tập & Chấm bài =====

enum AssignmentKind {
  PRACTICE
  TU
  MOCK
}

enum AssignmentStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  GRADED
}

/// Bài tập giao cho 1 lớp: tập câu hỏi cụ thể (AssignmentItem) + danh sách học
/// viên phải nộp chốt tại thời điểm giao (AssignmentRecipient).
model Assignment {
  id              String           @id @default(cuid())
  classId         String
  title           String
  kind            AssignmentKind
  /// id dạng bài trong lib/question-types.ts.
  questionTypeIds String[]
  note            String?
  dueAt           DateTime?
  notify          Boolean          @default(false)
  status          AssignmentStatus @default(OPEN)
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  class        Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  items        AssignmentItem[]
  recipients   AssignmentRecipient[]
  attempts     PracticeAttempt[]
  mockSessions MockTestSession[]

  @@index([classId, status])
  @@index([dueAt])
}

model AssignmentItem {
  id           String @id @default(cuid())
  assignmentId String
  questionId   String
  position     Int    @default(0)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// Restrict: câu hỏi đang nằm trong bài tập thì không xoá hẳn được (ẩn bằng archivedAt).
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, questionId])
  @@index([questionId])
}

/// Học viên phải nộp — chốt theo sĩ số lớp (ACTIVE) lúc giao bài.
model AssignmentRecipient {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  completedAt  DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

/// Rubric chấm của giáo viên theo dạng bài, có phiên bản — sửa được không cần lập trình.
model GradingRubric {
  id             String   @id @default(cuid())
  questionTypeId String
  version        Int      @default(1)
  /// [{ key, label, max }]
  criteria       Json
  isActive       Boolean  @default(true)
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  grades AttemptGrade[]

  @@unique([questionTypeId, version])
  @@index([questionTypeId, isActive])
}

/// Điểm giáo viên chấm cho 1 bài làm — lưu riêng, không ghi đè điểm AI
/// (PracticeAttempt.scorePct/pteScore vẫn dùng cho biểu đồ & điểm Mock test).
model AttemptGrade {
  id         String   @id @default(cuid())
  attemptId  String   @unique
  rubricId   String?
  /// [{ key, label, max, score }] — bản chụp rubric lúc chấm.
  criteria   Json
  total      Int
  maxTotal   Int
  comment    String?
  gradedById String
  gradedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attempt  PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  rubric   GradingRubric?  @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  gradedBy User            @relation("AttemptGradedBy", fields: [gradedById], references: [id])

  @@index([gradedById])
}
