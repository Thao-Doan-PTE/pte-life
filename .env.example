AUTH_SECRET=
DATABASE_URL="postgresql://user@localhost:5432/pte_life?schema=public"
ANTHROPIC_API_KEY=

# Azure AI Speech (Neural TTS) cho phần nghe của Write From Dictation.
# Azure Portal -> Create a resource -> "Speech" -> tạo resource riêng của
# PTE-Life -> "Keys and Endpoint" -> copy KEY + REGION vào đây.
# Nếu để trống, app tự fallback về giọng đọc máy của trình duyệt.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
